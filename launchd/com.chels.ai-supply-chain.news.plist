<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.chels.ai-supply-chain.news</string>
  <key>UserName</key><string>chelsqueck</string>
  <key>GroupName</key><string>staff</string>
  <key>WorkingDirectory</key><string>/Users/chelsqueck/ai-supply-chain</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/chelsqueck</string>
    <key>CLAUDE_BIN</key><string>/opt/homebrew/bin/claude</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>/Users/chelsqueck/ai-supply-chain/.venv/bin/python3 scripts/news_refresh.py &amp;&amp; /Users/chelsqueck/ai-supply-chain/.venv/bin/python3 scripts/publish.py -m "news refresh"</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/Users/chelsqueck/Library/Logs/ai-supply-chain-news.log</string>
  <key>StandardErrorPath</key><string>/Users/chelsqueck/Library/Logs/ai-supply-chain-news.log</string>
</dict>
</plist>
